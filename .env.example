# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_USER=securescope
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=securescope

# Optional tuning (defaults shown in backend/app/core/config.py)
SECURESCOPE_RETENTION_DAYS=30
SECURESCOPE_MAX_REDIRECTS=5
SECURESCOPE_REQUEST_TIMEOUT_SECONDS=8
SECURESCOPE_MAX_RESPONSE_BYTES=262144
SECURESCOPE_MAX_REQUESTS_PER_SCAN=6
SECURESCOPE_MAX_SCAN_SECONDS=25
SECURESCOPE_MAX_CONCURRENT_SCANS=3
SECURESCOPE_SCANS_PER_CLIENT_PER_HOUR=10
SECURESCOPE_SCANS_PER_TARGET_PER_HOUR=3
# Only behind a trusted reverse proxy that sets X-Forwarded-For.
SECURESCOPE_TRUST_PROXY_HEADERS=false
# TEST ONLY. Disables private-address (SSRF) protection. Never set outside automated tests.
# SECURESCOPE_ALLOW_PRIVATE_TARGETS=false

# Sessions / accounts
SECURESCOPE_SESSION_TTL_HOURS=12
# Compose defaults this to false for local HTTP. Set true when served over HTTPS.
SECURESCOPE_COOKIE_SECURE=false
SECURESCOPE_PUBLIC_BASE_URL=http://localhost:8080
SECURESCOPE_LOGIN_ATTEMPTS_PER_EMAIL_PER_15MIN=5
SECURESCOPE_LOGIN_ATTEMPTS_PER_IP_PER_15MIN=20
SECURESCOPE_REGISTRATIONS_PER_IP_PER_HOUR=10

# Website analytics (cookieless, public pages only). Only the signed-in account with this confirmed
# email address may open the Analytics page. Leave empty to switch the dashboards off.
# SECURESCOPE_ADMIN_EMAIL=you@example.com
# A long random value mixed into the daily visitor hash (random per start-up if empty).
# SECURESCOPE_ANALYTICS_SALT=
# SECURESCOPE_ANALYTICS_ENABLED=true
# SECURESCOPE_ANALYTICS_RETENTION_DAYS=90
# SECURESCOPE_TARGET_VERIFICATION_VALID_DAYS=180

# Bearer token for GET /metrics (Prometheus format). Unset = the endpoint does not exist.
# PDF report download links. Without a key a random one is made at every start (links then stop working after
# a restart). Use a long random value to keep them valid across restarts.
# SECURESCOPE_DOWNLOAD_SIGNING_KEY=
# SECURESCOPE_DOWNLOAD_URL_TTL_SECONDS=300
# Email confirmation is required before the dashboard can be used. Turn off only for local development.
# SECURESCOPE_REQUIRE_VERIFIED_EMAIL=true
# SECURESCOPE_METRICS_TOKEN=
