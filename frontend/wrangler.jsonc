{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "securescope",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Unknown paths get 404.html with a 404 status. The hash-route app only needs "/" and the three email-link
    // pages that scripts/postbuild.mjs adds. Only API calls run the Worker; every other request is a static file.
    "run_worker_first": ["/api/*"],
  },
  // Wakes the backend and runs the scheduled scans that are due. Needs the CRON_SECRET secret (see worker/index.js).
  "triggers": { "crons": ["*/15 * * * *"] },
}
